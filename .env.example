# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration (PostgreSQL)
# Use Supabase pooler/session URLs on Railway. Avoid db.<project>.supabase.co:5432 in hosted environments.
DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-region.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-region.pooler.supabase.com:5432/postgres"
DB_CONNECT_RETRIES=8
DB_CONNECT_RETRY_DELAY_MS=2500
REQUIRE_DB_ON_START=false

# Authentication
JWT_SECRET="your_jwt_secret_key_here"

# SMS Gateway (Termii/Africa's Talking)
TERMII_API_KEY="your_termii_api_key"
TERMII_SENDER_ID="Fixam"

# Firebase (Notifications)
FIREBASE_SERVICE_ACCOUNT_PATH="./config/firebase-service-account.json"

# Supabase
SUPABASE_URL="https://[PROJECT_ID].supabase.co"
SUPABASE_KEY="your_supabase_anon_key"

# Kora Pay (Mobile Money)
KORA_SECRET_KEY=
KORA_MOBILE_MONEY_URL=https://api.korapay.com/merchant/api/v1/charges/mobile-money
KORA_PAYMENT_STATUS_URL=https://api.korapay.com/merchant/api/v1/charges/:reference
KORA_WEBHOOK_SECRET=
